datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// MODULE A: CORE TENANCY, USERS & ACCESS CONTROL
// -------------------------------------------------------------

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model Organization {
  id          String             @id @default(uuid())
  name        String
  slug        String             @unique
  status      OrganizationStatus @default(ACTIVE)
  currency    String             @default("INR") // Configurable currency ISO code
  timezone    String             @default("Asia/Kolkata")
  settings    Json               @default("{}") // Configurable units, tax rules, cost codes
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  memberships  Membership[]
  roles        Role[]
  auditLogs    AuditLog[]
  customers    Customer[]
  contacts     Contact[]
  leads        Lead[]
  activities   Activity[]
  siteVisits   SiteVisit[]
  attachments  Attachment[]

  @@map("organizations")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITED
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  fullName     String
  phoneNumber  String?
  status       UserStatus  @default(ACTIVE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  memberships       Membership[]
  auditLogs         AuditLog[]
  assignedCustomers Customer[]
  assignedLeads     Lead[]
  assignedActivities Activity[]
  assignedVisits    SiteVisit[]   @relation("SiteVisitAssignee")
  createdVisits     SiteVisit[]   @relation("SiteVisitCreator")
  uploadedAttachments Attachment[]

  @@map("users")
}

enum MembershipStatus {
  ACTIVE
  REVOKED
  INVITED
}

model Membership {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  roleId         String
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  role           Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([organizationId, status])
  @@map("memberships")
}

model Role {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  code           String
  description    String?
  permissions    String[]
  isSystemRole   Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    Membership[]

  @@unique([organizationId, code])
  @@map("roles")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  POST
  REVERSE
  LOGIN
  REVOKE
  CONVERT
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  userId         String?
  action         AuditAction
  entityType     String
  entityId       String
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

// -------------------------------------------------------------
// MODULE B: CRM, CUSTOMERS, LEADS, ACTIVITIES & SITE VISITS
// -------------------------------------------------------------

enum CustomerType {
  INDIVIDUAL
  COMPANY
  GOVERNMENT
  DEVELOPER
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Customer {
  id             String         @id @default(uuid())
  organizationId String
  name           String
  companyName    String?
  customerType   CustomerType   @default(INDIVIDUAL)
  status         CustomerStatus @default(ACTIVE)
  email          String?
  phone          String?
  alternatePhone String?
  billingAddress Json?          // Street, city, state, postal code, country
  siteAddress    Json?          // Primary site/property address if known
  taxIdentifier  String?        // GSTIN / Tax ID only when verified
  assignedToId   String?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignedTo     User?          @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  contacts       Contact[]
  leads          Lead[]
  activities     Activity[]
  siteVisits     SiteVisit[]
  attachments    Attachment[]

  @@index([organizationId, status])
  @@index([organizationId, email])
  @@index([organizationId, phone])
  @@map("customers")
}

model Contact {
  id             String       @id @default(uuid())
  organizationId String
  customerId     String
  name           String
  designation    String?
  email          String?
  phone          String?
  isPrimary      Boolean      @default(false)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId, customerId])
  @@map("contacts")
}

enum LeadStatus {
  NEW
  QUALIFIED
  SITE_VISIT_SCHEDULED
  SITE_VISIT_COMPLETED
  ESTIMATION
  QUOTATION_SENT
  NEGOTIATION
  WON
  LOST
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Lead {
  id                  String       @id @default(uuid())
  organizationId      String
  customerId          String?      // Optional during initial enquiry, linked upon qualification/conversion
  title               String       // Project opportunity title e.g. "Villa Construction - Sector 4"
  source              String       // E.g. "Referral", "Website", "Site Banner", "Walk-in"
  status              LeadStatus   @default(NEW)
  priority            LeadPriority @default(MEDIUM)
  constructionType    String?      // E.g. "Residential Villa", "Commercial Interior", "Industrial Shed"
  estimatedBudget     Decimal?     @db.Decimal(15, 2)
  expectedStartDate   DateTime?
  expectedCloseDate   DateTime?
  lossReason          String?
  requirements        String?
  assignedToId        String?
  contactName         String?      // Captured prior to formal customer creation
  contactPhone        String?
  contactEmail        String?
  siteAddress         String?
  convertedAt         DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer            Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedTo          User?        @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  activities          Activity[]
  siteVisits          SiteVisit[]
  attachments         Attachment[]

  @@index([organizationId, status])
  @@index([organizationId, assignedToId])
  @@map("leads")
}

enum ActivityType {
  CALL
  MEETING
  NOTE
  TASK
  EMAIL
}

enum ActivityStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model Activity {
  id             String         @id @default(uuid())
  organizationId String
  customerId     String?
  leadId         String?
  type           ActivityType
  subject        String
  description    String?
  dueDate        DateTime?
  status         ActivityStatus @default(PENDING)
  priority       LeadPriority   @default(MEDIUM)
  assignedToId   String?
  completedAt    DateTime?
  outcomeNotes   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer       Customer?      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lead           Lead?          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedTo     User?          @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, dueDate])
  @@index([organizationId, leadId])
  @@index([organizationId, customerId])
  @@map("activities")
}

enum SiteVisitStatus {
  SCHEDULED
  COMPLETED
  RESCHEDULED
  CANCELLED
}

model SiteVisit {
  id             String          @id @default(uuid())
  organizationId String
  customerId     String?
  leadId         String?
  assignedToId   String
  createdById    String
  scheduledDate  DateTime
  status         SiteVisitStatus @default(SCHEDULED)
  siteAddress    String
  siteLatitude   Decimal?        @db.Decimal(10, 8)
  siteLongitude  Decimal?        @db.Decimal(11, 8)
  notes          String?
  measurements   Json?           // Dimensions, plot boundaries, built-up area
  outcomeNotes   String?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lead           Lead?           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedTo     User            @relation("SiteVisitAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  createdBy      User            @relation("SiteVisitCreator", fields: [createdById], references: [id], onDelete: Restrict)
  attachments    Attachment[]

  @@index([organizationId, status, scheduledDate])
  @@index([organizationId, leadId])
  @@index([organizationId, assignedToId])
  @@map("site_visits")
}

model Attachment {
  id             String       @id @default(uuid())
  organizationId String
  customerId     String?
  leadId         String?
  siteVisitId    String?
  uploadedById   String
  fileName       String
  fileSize       Int
  mimeType       String
  storageKey     String       // Unique private storage path
  description    String?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  siteVisit      SiteVisit?   @relation(fields: [siteVisitId], references: [id], onDelete: Cascade)
  uploadedBy     User         @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([organizationId, siteVisitId])
  @@index([organizationId, leadId])
  @@index([organizationId, customerId])
  @@map("attachments")
}
