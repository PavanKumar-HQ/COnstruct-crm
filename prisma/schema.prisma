datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// MODULE A: CORE TENANCY, USERS & ACCESS CONTROL (PHASE 1)
// -------------------------------------------------------------

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model Organization {
  id          String             @id @default(uuid())
  name        String
  slug        String             @unique
  status      OrganizationStatus @default(ACTIVE)
  currency    String             @default("INR") // Configurable currency ISO code
  timezone    String             @default("Asia/Kolkata")
  settings    Json               @default("{}") // Configurable units, tax rules, cost codes
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  memberships Membership[]
  roles       Role[]
  auditLogs   AuditLog[]

  @@map("organizations")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITED
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  fullName     String
  phoneNumber  String?
  status       UserStatus  @default(ACTIVE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  memberships  Membership[]
  auditLogs    AuditLog[]

  @@map("users")
}

enum MembershipStatus {
  ACTIVE
  REVOKED
  INVITED
}

model Membership {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  roleId         String
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  role           Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([organizationId, status])
  @@map("memberships")
}

model Role {
  id             String       @id @default(uuid())
  organizationId String
  name           String       // E.g., "Administrator", "Project Manager", "Site Engineer", "Accounts"
  code           String       // E.g., "ADMIN", "PM", "SITE_ENG", "FINANCE"
  description    String?
  permissions    String[]     // Array of atomic permission keys e.g. ["projects:read", "finance:write"]
  isSystemRole   Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    Membership[]

  @@unique([organizationId, code])
  @@map("roles")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  POST
  REVERSE
  LOGIN
  REVOKE
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  userId         String?
  action         AuditAction
  entityType     String       // E.g., "User", "Contract", "Invoice", "Payment", "StockMovement"
  entityId       String
  metadata       Json?        // Change delta or event context
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, createdAt])
  @@map("audit_logs")
}
