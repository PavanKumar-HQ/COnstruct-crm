# Runtime & Database Environment Configuration
# Node.js LTS target: v20.x or v22.x LTS (compatible with Node 20+)

# PostgreSQL Database Connection
# Local development database URL
DATABASE_URL="postgresql://pavankumars@localhost:5432/construct_crm_dev?schema=public"

# Database URL for automated tests (isolated test database)
TEST_DATABASE_URL="postgresql://pavankumars@localhost:5432/construct_crm_test?schema=public"

# Application Environment
NODE_ENV="development"
APP_ENV="local"
APP_URL="http://localhost:3000"

# Authentication & Session Secrets
# Generate using: openssl rand -base64 32
AUTH_SECRET="insecure_dev_secret_replace_in_production_32bytes_long"
AUTH_SESSION_COOKIE_NAME="construct_crm_session"
AUTH_SESSION_TTL_HOURS=24

# Storage Configuration
# Values: "local" (development default) | "s3" | "supabase"
STORAGE_DRIVER="local"
STORAGE_LOCAL_ROOT="./storage/uploads"

# Audit and Compliance
AUDIT_LOG_ENABLED="true"

