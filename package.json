{
  "name": "construct-crm",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed:demo": "npx tsx src/scripts/seed-demo.ts",
    "db:verify:demo": "npx tsx src/scripts/verify-demo.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "6.4.1",
    "bcryptjs": "3.0.2",
    "clsx": "2.1.1",
    "decimal.js": "10.6.0",
    "jose": "6.0.8",
    "lucide-react": "1.16.0",
    "next": "15.2.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "3.0.2",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.13.9",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "eslint": "9.21.0",
    "eslint-config-next": "15.2.1",
    "postcss": "8.5.3",
    "prisma": "6.4.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.2",
    "vitest": "3.0.7"
  }
}

